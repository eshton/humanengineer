---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { SITE, HOME } from "@consts";
import FeaturedCard from "@components/FeaturedCard.astro";
import CoverCard from "@components/CoverCard.astro";
import profile from "../assets/profile.jpg";

const notDraft = (e: { data: { draft?: boolean } }) => !e.data.draft;
const byDate = (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf();

const articles = (await getCollection("articles")).filter(notDraft).sort(byDate);
const posts = (await getCollection("posts")).filter(notDraft).sort(byDate);
const projects = (await getCollection("projects"))
  .filter(notDraft)
  .sort(byDate)
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const featured = articles[0];

// "Latest" mixes remaining articles + posts, newest first — "recent anything".
type Mixed = { entry: CollectionEntry<"articles" | "posts">; kind: string };
const latest: Mixed[] = [
  ...articles.slice(1).map((e) => ({ entry: e, kind: "Article" })),
  ...posts.map((e) => ({ entry: e, kind: "Post" })),
]
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <div class="hd-wrap">
    <!-- Hero -->
    <section class="hd-hero animate">
      <div class="inner">
        <div class="hd-avatar">
          <Image src={profile} alt="Agoston Fung" width={300} height={300} />
        </div>
        <div>
          <h1>Agoston Fung</h1>
          <p class="tag">
            Notes on <b>engineering</b>, <b>AI</b>, and the people writing it.
          </p>
          <div class="hd-cta">
            <a class="hd-btn primary" href="/articles">
              Read the articles
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
              >
            </a>
            <a class="hd-btn" href="https://github.com/eshton" target="_blank" rel="me">
              <svg viewBox="0 0 24 24" fill="currentColor"
                ><path
                  d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10.3 10.3 0 0 0 22 12.3C22 6.6 17.5 2 12 2z"
                ></path></svg
              >
              eshton
            </a>
            <a
              class="hd-btn"
              href="https://www.linkedin.com/in/agostonfung"
              target="_blank"
              rel="me"
            >
              <svg viewBox="0 0 24 24" fill="currentColor"
                ><path
                  d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.3 18V10H5.7v8h2.6zM7 8.8A1.5 1.5 0 1 0 7 5.8a1.5 1.5 0 0 0 0 3zM18.3 18v-4.4c0-2.4-1.3-3.5-3-3.5-1.4 0-2 .8-2.3 1.3V10H10.4v8H13v-4.5c0-1.2.6-1.8 1.4-1.8s1.3.6 1.3 1.8V18h2.6z"
                ></path></svg
              >
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured -->
    {
      featured && (
        <section class="hd-section animate" style="margin-top:52px">
          <div class="hd-shead">
            <h2>
              <span class="bar-i" />Featured
            </h2>
            <a href="/articles">ALL ARTICLES &rarr;</a>
          </div>
          <FeaturedCard entry={featured} />
        </section>
      )
    }

    <!-- Latest (articles + posts) -->
    <section class="hd-section animate">
      <div class="hd-shead">
        <h2><span class="bar-i"></span>Latest</h2>
        <a href="/posts">EVERYTHING &rarr;</a>
      </div>
      <div class="hd-grid">
        {latest.map((m) => <CoverCard entry={m.entry} kind={m.kind} />)}
      </div>
    </section>

    <!-- Projects -->
    <section class="hd-section animate">
      <div class="hd-shead">
        <h2><span class="bar-i"></span>Projects</h2>
        <a href="/projects">ALL WORK &rarr;</a>
      </div>
      <div class="hd-pgrid">
        {
          projects.map((p) => (
            <a href={`/projects/${p.id}`} class="hd-pcard">
              <span class="k">{p.data.projectType ?? "Project"}</span>
              <h3>{p.data.title}</h3>
              {(p.data.summary ?? p.data.description) && (
                <p>{p.data.summary ?? p.data.description}</p>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Connect -->
    <section class="hd-section animate" style="margin-bottom:8px">
      <p class="hd-connect">
        Get in touch &mdash;
        <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a>
      </p>
    </section>
  </div>
</Layout>
