---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import CoverCard from "@components/CoverCard.astro";
import { POSTS } from "@consts";

const posts = (await getCollection("posts"))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={POSTS.TITLE} description={POSTS.DESCRIPTION}>
  <div class="hd-wrap" data-pagefind-ignore>
    <div class="hd-shead animate">
      <h2><span class="bar-i"></span>Posts</h2>
    </div>
    <div class="hd-grid animate">
      {posts.map((e) => <CoverCard entry={e} kind="Post" />)}
    </div>
  </div>
</Layout>
