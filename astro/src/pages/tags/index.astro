---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const entries = [
  ...(await getCollection("posts", ({ data }) => !data.draft)),
  ...(await getCollection("articles", ({ data }) => !data.draft)),
];
const tags = [...new Set(entries.flatMap((e) => e.data.tags || []))].sort();
---

<Layout title="Tags" description="Topics written about here.">
  <Container>
    <div class="space-y-10">
      <h1 class="animate font-display text-2xl font-bold">All tags</h1>
      <div class="animate flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-sm border border-black/15 px-2 py-1 text-sm transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white"
            >
              {tag}{" "}
              <span class="text-gray-500">
                ({entries.filter((e) => e.data.tags?.includes(tag)).length})
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
