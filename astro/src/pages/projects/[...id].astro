---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { siblings } from "@lib/nav";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((e) => !e.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((entry) => ({ params: { id: entry.id }, props: entry }));
}
type Props = CollectionEntry<"projects">;

const projects = (await getCollection("projects"))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const { prev, next } = siblings(projects, Astro.params.id!);

const project = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;

const specs: { label: string; value?: string; href?: string }[] = [
  { label: "Title", value: d.fullTitle },
  { label: "Type", value: d.projectType },
  { label: "Platform", value: d.platform },
  { label: "Status", value: d.status },
  { label: "Link", value: d.link, href: d.link },
].filter((s) => s.value);
---

<Layout title={project.data.title} description={d.summary ?? d.description ?? ""}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/projects">Back to projects</BackToPrevious>
    </div>
    <div class="animate my-10 space-y-3">
      <div class="flex items-center gap-1.5 text-sm">
        <FormattedDate date={project.data.date} />
      </div>
      <h1 class="font-display text-4xl font-bold tracking-tight text-black dark:text-white">
        {project.data.title}
      </h1>
    </div>

    {
      specs.length > 0 && (
        <dl class="project-specs animate">
          {specs.map((s) => (
            <div class="spec-row">
              <dt>{s.label}</dt>
              <dd>
                {s.href ? (
                  <a href={s.href} target="_blank" rel="noopener">
                    {s.value}
                  </a>
                ) : (
                  s.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      project.data.cover && (
        <div class="animate mb-10 overflow-hidden rounded-xl">
          <Image
            src={project.data.cover.image}
            alt={project.data.cover.alt ?? project.data.title}
            width={1600}
            height={840}
          />
        </div>
      )
    }
    {headings.length > 0 && <TableOfContents headings={headings} />}
    <article class="animate">
      <Content />
      <div class="mt-24">
        <PostNavigation prevPost={prev} nextPost={next} />
      </div>
    </article>
  </Container>
</Layout>
