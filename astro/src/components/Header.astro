---
import { SITE } from "@consts";

const nav = [
  { href: "/posts", label: "Posts" },
  { href: "/articles", label: "Articles" },
  { href: "/projects", label: "Projects" },
  { href: "/cv", label: "Experience" },
  { href: "/photography", label: "Photography" },
  { href: "/about", label: "About" },
];
---

<header transition:persist>
  <div class="hd-wrap">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <a href="/" class="text-2xl font-bold tracking-tight text-black dark:text-white">
        {SITE.TITLE}
      </a>
      <nav class="flex flex-wrap items-center gap-x-7 gap-y-1 text-[17px]">
        {
          nav.map((n) => (
            <a
              href={n.href}
              class="text-black/90 transition-colors duration-200 hover:text-black dark:text-white/85 dark:hover:text-white"
            >
              {n.label}
            </a>
          ))
        }
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="ml-1 flex items-center text-black/90 transition-colors duration-200 hover:text-black dark:text-white/85 dark:hover:text-white"
        >
          <svg
            width="21"
            height="21"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg
          >
        </button>
      </nav>
    </div>
  </div>
</header>
