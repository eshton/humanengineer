---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <div class="hd-wrap">
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center">
      <span>&copy; {new Date().getFullYear()} {SITE.TITLE}</span>
      <a class="hover:text-black" href="https://github.com/eshton">GitHub</a>
      <a class="hover:text-black" href="https://www.linkedin.com/in/agostonfung">LinkedIn</a>
      <a class="hover:text-black" href={`mailto:${SITE.EMAIL}`}>Email</a>
      <a class="hover:text-black" href="/rss.xml">RSS</a>
      <BackToTop />
    </div>
  </div>
</footer>
