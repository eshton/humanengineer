---
const { currentPage, totalPages } = Astro.props as {
  currentPage: number;
  totalPages: number;
};

const pageUrl = (n: number) => (n <= 1 ? "/posts" : `/posts/page/${n}`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      <a
        class:list={["pg-arrow", { disabled: currentPage <= 1 }]}
        href={currentPage > 1 ? pageUrl(currentPage - 1) : undefined}
        aria-disabled={currentPage <= 1}
      >
        &larr; Newer
      </a>
      <div class="pg-nums">
        {pages.map((n) => (
          <a class:list={["pg-num", { current: n === currentPage }]} href={pageUrl(n)}>
            {n}
          </a>
        ))}
      </div>
      <a
        class:list={["pg-arrow", { disabled: currentPage >= totalPages }]}
        href={currentPage < totalPages ? pageUrl(currentPage + 1) : undefined}
        aria-disabled={currentPage >= totalPages}
      >
        Older &rarr;
      </a>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
  }
  .pg-nums {
    display: flex;
    gap: 6px;
  }
  .pagination a {
    color: var(--hd-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .pg-num {
    min-width: 30px;
    padding: 4px 8px;
    text-align: center;
    border-radius: 6px;
  }
  .pg-num.current {
    background: var(--brand);
    color: #fff;
  }
  .pagination a:hover:not(.current) {
    color: var(--brand);
  }
  .pg-arrow.disabled {
    opacity: 0.35;
    pointer-events: none;
  }
</style>
